# OS and IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & Secrets (Never commit secrets)
.env
.env.backup
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backend - Laravel & Composer
backend/vendor/
backend/bootstrap/cache/*.php
backend/storage/app/public/attachments/*
!backend/storage/app/public/attachments/.gitkeep
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/.phpunit.cache/
backend/.pest/
backend/.phpstan.cache/

# Frontend - Node & Vite
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker & Database local data
docker/mysql/data/
docker/redis/data/
